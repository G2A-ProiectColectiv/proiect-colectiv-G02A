# Copiaza acest fisier ca backend/.env si completeaza valorile tale.
# backend/.env NU se comite niciodata.
DB_URL=jdbc:postgresql://localhost:5432/rental_platform
DB_USERNAME=
DB_PASSWORD=

# Se completeaza in etapele urmatoare (1.1.6 si 1.1.7):
# JWT_SECRET=         (minim 32 de caractere)
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH='<hash BCrypt, intre ghilimele simple>'

# Optional: originile frontendului acceptate de CORS, separate prin virgula (implicit http://localhost:3000).
# Next.js transmite antetul Origin si prin rewrites, deci pune aici adresa de unde e servit frontendul.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
